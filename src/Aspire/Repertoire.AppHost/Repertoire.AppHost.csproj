<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.1"/>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAspireHost>true</IsAspireHost>
        <!-- 13.5 warns (ASPIRE010) when this is off. We drive the AppHost with the `aspire` CLI,
             so opt into the bundle rather than suppressing the warning. -->
        <AspireUseCliBundle>true</AspireUseCliBundle>
        <!-- Generated parameter values (the postgres password) must persist to user-secrets.
             Mercury learned this the hard way: a persistent-lifetime container is reused only
             while its config hash is unchanged, so a password regenerated on every run changes
             the hash and Aspire silently RECREATES the container — taking the data with it. -->
        <UserSecretsId>repertoire-apphost-4f2a8e11</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Api\Repertoire.Api\Repertoire.Api.csproj"/>
    </ItemGroup>

</Project>
